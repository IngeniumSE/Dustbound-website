---
import { Image } from 'astro:assets';
import collection from '../assets/screenshots/collection.png';
import pairingTrade from '../assets/screenshots/pairing-trade.png';
import events from '../assets/screenshots/events.png';
import achievements from '../assets/screenshots/achievements.png';

const features = [
  {
    src: collection,
    kicker: 'Collection',
    title: 'Track Collected & Mastered',
    body: 'Check off Collectibles as you find them. Your list lives on your phone — Collected, Mastered, and ready for the next season.',
  },
  {
    src: pairingTrade,
    kicker: 'Pairing',
    title: 'Trade & index Sprites',
    body: 'Find other Dustbound players who can help you obtain Collectibles. Trading or indexing — in-app, we call this Pairing.',
  },
  {
    src: events,
    kicker: 'Events',
    title: 'The season stays current',
    body: 'When you’re online, the catalog and Events list refresh — so Golden Hours and the rest of the garden calendar stay in sync.',
  },
  {
    src: achievements,
    kicker: 'Achievements',
    title: 'Earn as you collect',
    body: 'Unlock fun Achievements as you collect, master, and close Pairings.',
  },
];
---
<section class="mb-14" aria-labelledby="does-heading" data-testid="app-showcase">
  <div class="mb-6 max-w-xl sm:mb-8">
    <p class="mb-2 text-xs font-bold uppercase tracking-[0.16em] text-accent" id="does-heading">What it does</p>
    <h2 class="text-2xl font-black tracking-tight text-ink sm:text-3xl">The garden, on your phone</h2>
    <p class="mt-2 text-sm text-muted sm:text-base">
      Swipe through Collection, Pairing, Events, and Achievements.
    </p>
  </div>

  <div class="feature-carousel" data-testid="what-it-does" data-feature-carousel>
    <div class="feature-carousel__tabs" role="tablist" aria-label="What Dustbound does">
      {features.map((feature, i) => (
        <button
          type="button"
          class="feature-carousel__tab"
          role="tab"
          id={`feature-tab-${i}`}
          aria-controls={`feature-slide-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          data-feature-tab={i}
        >
          {feature.kicker}
        </button>
      ))}
    </div>

    <div class="feature-carousel__stage">
      <button
        type="button"
        class="feature-carousel__arrow feature-carousel__arrow--prev"
        data-feature-prev
        aria-label="Previous feature"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M14.5 5.5 8 12l6.5 6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>

      <div class="feature-carousel__track" data-feature-track tabindex="0" aria-roledescription="carousel">
        {features.map((feature, i) => (
          <article
            class="feature-carousel__slide"
            id={`feature-slide-${i}`}
            role="tabpanel"
            aria-labelledby={`feature-tab-${i}`}
            data-feature-slide={i}
          >
            <figure class="feature-carousel__phone">
              <div class="phone-bezel">
                <Image
                  src={feature.src}
                  alt={feature.title}
                  widths={[240, 360, 480, 720]}
                  sizes="(max-width: 768px) 58vw, 240px"
                  quality={75}
                  class="phone-screen"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </div>
            </figure>
            <div class="feature-carousel__copy">
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent">{feature.kicker}</p>
              <h3 class="mt-2 text-xl font-black tracking-tight text-ink sm:text-2xl">{feature.title}</h3>
              <p class="mt-3 text-sm text-muted sm:text-base">{feature.body}</p>
            </div>
          </article>
        ))}
      </div>

      <button
        type="button"
        class="feature-carousel__arrow feature-carousel__arrow--next"
        data-feature-next
        aria-label="Next feature"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9.5 5.5 16 12l-6.5 6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-feature-carousel]');
  const track = root?.querySelector('[data-feature-track]');
  const slides = root ? [...root.querySelectorAll('[data-feature-slide]')] : [];
  const tabs = root ? [...root.querySelectorAll('[data-feature-tab]')] : [];
  if (!(root instanceof HTMLElement) || !(track instanceof HTMLElement) || slides.length === 0) {
    // Carousel markup missing — leave the static slides in place.
  } else {
    const count = slides.length;
    let index = 0;

    const mark = (next: number) => {
      index = (next + count) % count;
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.classList.toggle('is-active', on);
      });
    };

    const go = (next: number) => {
      mark(next);
      const slide = slides[index];
      if (!(slide instanceof HTMLElement)) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollTo({
        left: slide.offsetLeft - track.offsetLeft,
        behavior: reduce ? 'auto' : 'smooth',
      });
    };

    tabs[0]?.classList.add('is-active');

    root.querySelector('[data-feature-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-feature-next]')?.addEventListener('click', () => go(index + 1));

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => go(i));
    });

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        go(index - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        go(index + 1);
      }
    });

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting && entry.intersectionRatio > 0.55)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible?.target) return;
        const next = Number((visible.target as HTMLElement).dataset.featureSlide);
        if (Number.isInteger(next) && next !== index) mark(next);
      },
      { root: track, threshold: [0.55, 0.75] },
    );
    slides.forEach((slide) => observer.observe(slide));
  }
</script>
