---
import { Image } from 'astro:assets';
import checklist from '../assets/screenshots/checklist.png';
import achievement from '../assets/screenshots/achievement.png';
import filters from '../assets/screenshots/filters.png';

const shots = [
  {
    src: filters,
    label: 'Filter & find Sprites',
    role: 'side',
  },
  {
    src: checklist,
    label: 'Track Collected & Mastered',
    role: 'hero',
  },
  {
    src: achievement,
    label: 'Earn Achievements',
    role: 'side',
  },
] as const;
---
<section class="mb-14" aria-labelledby="showcase-heading" data-testid="app-showcase">
  <div class="mb-6 max-w-xl">
    <p class="mb-2 text-xs font-bold uppercase tracking-[0.16em] text-accent">Inside Dustbound</p>
    <h2 id="showcase-heading" class="text-2xl font-black tracking-tight text-ink sm:text-3xl">The garden, on your phone</h2>
    <p class="mt-2 text-sm text-muted sm:text-base">
      Checklist, filters, and Achievements — local-first, offline when you need it.
    </p>
  </div>

  <div class="showcase-stage relative flex flex-col items-center gap-8 md:flex-row md:items-end md:justify-center md:gap-5 lg:gap-8">
    <div class="pointer-events-none absolute inset-x-8 bottom-0 top-1/3 -z-10 rounded-full bg-accent/10 blur-3xl" aria-hidden="true"></div>
    {shots.map((shot, i) => (
      <figure
        class:list={[
          'phone-frame showcase-phone',
          shot.role === 'hero' ? 'phone-frame--hero z-10' : 'phone-frame--side z-[1] md:mb-6',
        ]}
        style={`--phone-delay: ${i * 0.12}s`}
      >
        <div class="phone-bezel">
          <Image
            src={shot.src}
            alt={shot.label}
            widths={[240, 360, 480, 720]}
            sizes={shot.role === 'hero' ? '(max-width: 768px) 70vw, 280px' : '(max-width: 768px) 55vw, 220px'}
            quality={75}
            class="phone-screen"
            loading="lazy"
          />
        </div>
        <figcaption class="mt-3 text-center text-xs font-semibold uppercase tracking-wider text-muted">
          {shot.label}
        </figcaption>
      </figure>
    ))}
  </div>
</section>
