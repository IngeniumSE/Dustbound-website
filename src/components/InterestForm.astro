---
const endpoint = 'https://formspree.io/f/xaewepjp';
---
<form
  id="interest-form"
  class="flex flex-col gap-3 sm:flex-row sm:items-end"
  action={endpoint}
  method="POST"
  data-testid="interest-form"
>
  <label class="sr-only" for="interest-email">Email</label>
  <input
    id="interest-email"
    class="w-full flex-1 rounded-2xl border border-border bg-panel/70 px-4 py-3 text-ink placeholder:text-muted/70"
    type="email"
    name="email"
    required
    autocomplete="email"
    placeholder="you@email.com"
    data-testid="interest-email"
  />
  <!-- Formspree honeypot -->
  <input
    type="text"
    name="_gotcha"
    class="absolute -left-[9999px] h-0 w-0 opacity-0"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    data-testid="honeypot"
  />
  <button
    type="submit"
    class="inline-flex shrink-0 items-center justify-center rounded-2xl bg-accent px-5 py-3 text-sm font-extrabold text-accent-ink hover:brightness-110 disabled:opacity-60"
    data-fs-submit-btn
    data-testid="notify-me"
  >
    Notify me
  </button>
</form>
<p id="interest-thanks" class="mt-3 hidden text-sm font-semibold text-lime" data-testid="interest-thanks" role="status">
  Thanks — we’ll email you when it’s ready.
</p>
<p id="interest-error" class="mt-3 hidden text-sm font-semibold text-red-300" data-testid="interest-error" role="alert"></p>

<script>
  const form = document.getElementById('interest-form');
  const thanks = document.getElementById('interest-thanks');
  const errorEl = document.getElementById('interest-error');
  const btn = form?.querySelector('[data-fs-submit-btn]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    errorEl?.classList.add('hidden');
    if (btn instanceof HTMLButtonElement) btn.disabled = true;

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error('Something went wrong — try again in a moment.');
      thanks?.classList.remove('hidden');
      form.reset();
    } catch (err) {
      const message = err instanceof Error ? err.message : 'Something went wrong.';
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.classList.remove('hidden');
      }
    } finally {
      if (btn instanceof HTMLButtonElement) btn.disabled = false;
    }
  });
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
