---
---
<form
  id="interest-form"
  class="flex w-full flex-col gap-3 sm:flex-row sm:items-end"
  action="https://formspree.io/f/xaewepjp"
  method="POST"
>
  <div class="min-w-0 flex-1">
    <label for="interest-email" class="mb-1.5 block text-xs font-bold uppercase tracking-[0.14em] text-accent">
      Email
    </label>
    <input
      id="interest-email"
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder="you@email.com"
      class="w-full rounded-2xl border border-border bg-panel/70 px-3.5 py-3 text-ink placeholder:text-muted/60"
    />
  </div>
  <!-- Formspree honeypot -->
  <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <button
    id="interest-submit"
    type="submit"
    class="inline-flex shrink-0 items-center justify-center rounded-2xl bg-accent px-5 py-3 font-extrabold text-accent-ink hover:brightness-105"
  >
    Notify me
  </button>
</form>
<p id="interest-thanks" class="mt-3 hidden text-lime" role="status">Thanks — we’ll email you when it’s ready.</p>
<p id="interest-error" class="mt-3 hidden text-orange-300" role="alert"></p>

<script>
  const form = document.getElementById('interest-form');
  const thanks = document.getElementById('interest-thanks');
  const errorEl = document.getElementById('interest-error');
  const submitBtn = document.getElementById('interest-submit');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    errorEl?.classList.add('hidden');
    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.disabled = true;
    }
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error('Something went wrong. Please try again.');
      thanks?.classList.remove('hidden');
      form.reset();
    } catch (err) {
      if (errorEl) {
        errorEl.textContent = err instanceof Error ? err.message : 'Something went wrong.';
        errorEl.classList.remove('hidden');
      }
    } finally {
      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = false;
      }
    }
  });
</script>
