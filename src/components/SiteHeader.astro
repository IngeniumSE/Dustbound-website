---
const path = Astro.url.pathname;
const links = [
  { href: '/privacy/', label: 'Privacy' },
  { href: '/support/', label: 'Support' },
  { href: '/cookies/', label: 'Cookies' },
];
---
<header class="relative z-10 flex items-center justify-between gap-4 px-5 py-4 md:px-8">
  <a href="/" class="text-ink font-extrabold tracking-wide no-underline hover:no-underline">Dustbound</a>
  <nav class="flex flex-wrap gap-4 text-sm text-muted" aria-label="Site">
    {links.map((l) => (
      <a
        href={l.href}
        class:list={[
          'no-underline hover:text-accent hover:underline',
          path.startsWith(l.href) && 'text-accent',
        ]}
      >
        {l.label}
      </a>
    ))}
  </nav>
</header>
