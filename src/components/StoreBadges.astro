---
import { APP_STORE_URL, GOOGLE_PLAY_URL } from '../lib/stores';

interface Props {
  size?: 'hero' | 'compact';
}

const { size = 'hero' } = Astro.props;
const compact = size === 'compact';
---
<div
  class:list={['store-badges', compact && 'store-badges--compact']}
  data-store-badges
  data-testid={compact ? 'store-badges-compact' : 'store-badges'}
>
  <a
    class="store-badge"
    data-store="google"
    href={GOOGLE_PLAY_URL}
    aria-label="Get it on Google Play"
  >
    <span class="store-badge__lockup">
      <svg class="store-badge__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="#4285F4" d="M3.05 2.3c-.4.2-.7.6-.8 1.1v17.2c.1.5.4.9.8 1.1l.1.05 9.6-9.65v-.2L3.15 2.25z"></path>
        <path fill="#34A853" d="M16.8 16.05 13.05 12.3 3.15 21.75c.3.16.65.25 1.02.25.4 0 .76-.12 1.1-.32l11.53-5.63z"></path>
        <path fill="#FBBC04" d="M20.85 10.55 16.8 8.2l-3.75 4.1 3.75 3.75 4.05-2.32c.9-.52.9-1.93 0-2.18z"></path>
        <path fill="#EA4335" d="M16.8 8.2 5.27 2.32C4.93 2.12 4.57 2 4.17 2c-.37 0-.72.09-1.02.25L13.05 12.3z"></path>
      </svg>
      <span class="store-badge__copy">
        <span class="store-badge__kicker">Get it on</span>
        <span class="store-badge__name">Google Play</span>
      </span>
    </span>
  </a>

  <a
    class="store-badge"
    data-store="apple"
    href={APP_STORE_URL}
    aria-label="Download on the App Store"
  >
    <span class="store-badge__lockup">
      <svg class="store-badge__icon store-badge__icon--apple" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
        ></path>
      </svg>
      <span class="store-badge__copy">
        <span class="store-badge__kicker">Download on the</span>
        <span class="store-badge__name">App Store</span>
      </span>
    </span>
  </a>
</div>

<script is:inline>
  (function () {
    var root = document.currentScript && document.currentScript.previousElementSibling;
    if (!root || document.documentElement.getAttribute('data-store-pref') !== 'apple') return;
    var apple = root.querySelector('[data-store="apple"]');
    if (apple) root.insertBefore(apple, root.firstChild);
  })();
</script>
