---
interface Props {
  kind: 'sprites' | 'achievements' | 'pairing';
}

const { kind } = Astro.props;

const labels = {
  sprites: 'Sprites',
  achievements: 'Achievements',
  pairing: 'Pairing',
} as const;
---
<span class="upcoming-icon" aria-hidden="true" data-icon={kind} title={labels[kind]}>
  {kind === 'sprites' && (
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-full w-full">
      <circle cx="16" cy="28" r="8" stroke="currentColor" stroke-width="2.2" />
      <circle cx="32" cy="28" r="8" stroke="currentColor" stroke-width="2.2" />
      <circle cx="24" cy="16" r="8" stroke="currentColor" stroke-width="2.2" fill="color-mix(in srgb, currentColor 14%, transparent)" />
      <path d="M24 10.5v3.2M24 18.8v3.2M17.8 16h3.2M27 16h3.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  )}
  {kind === 'achievements' && (
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-full w-full">
      <path
        d="M24 6.5c6.2 0 11.2 4.4 11.2 12.2 0 9.4-7.4 16.2-11.2 23.3-3.8-7.1-11.2-13.9-11.2-23.3C12.8 10.9 17.8 6.5 24 6.5Z"
        stroke="currentColor"
        stroke-width="2.2"
        fill="color-mix(in srgb, currentColor 12%, transparent)"
      />
      <path
        d="M24 14.2l1.55 3.35 3.65.4-2.75 2.45.8 3.55L24 22.2l-3.25 1.75.8-3.55-2.75-2.45 3.65-.4L24 14.2Z"
        fill="currentColor"
      />
    </svg>
  )}
  {kind === 'pairing' && (
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-full w-full">
      <circle cx="16.5" cy="24" r="8" stroke="currentColor" stroke-width="2.2" fill="color-mix(in srgb, currentColor 12%, transparent)" />
      <circle cx="31.5" cy="24" r="8" stroke="currentColor" stroke-width="2.2" fill="color-mix(in srgb, currentColor 12%, transparent)" />
      <path d="M21 24h6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
      <path d="M16.5 20.2v7.6M31.5 20.2v7.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity="0.55" />
    </svg>
  )}
</span>
