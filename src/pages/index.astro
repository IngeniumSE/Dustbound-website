---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import StoreBadges from '../components/StoreBadges.astro';
import SpriteConstellation from '../components/SpriteConstellation.astro';
import AppShowcase from '../components/AppShowcase.astro';
import SeasonFour from '../components/SeasonFour.astro';
import EventsSection from '../components/EventsSection.astro';
import gardenBg from '../assets/garden_pond_bg.jpg';
import appIcon from '../assets/brand/app-icon.png';
import { APP_STORE_URL, GOOGLE_PLAY_URL } from '../lib/stores';

const appDescription =
  'Local checklist for Sprite collectibles — track Collected and Mastered offline on iOS and Android.';

const appSchema = [
  {
    '@type': 'MobileApplication',
    '@id': 'https://dustbound.app/#app-android',
    name: 'Dustbound',
    description: appDescription,
    url: 'https://dustbound.app/',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'ANDROID',
    installUrl: GOOGLE_PLAY_URL,
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      priceCurrency: 'USD',
    },
    image: 'https://dustbound.app/og.jpg',
    author: { '@id': 'https://dustbound.app/#organization' },
  },
  {
    '@type': 'MobileApplication',
    '@id': 'https://dustbound.app/#app-ios',
    name: 'Dustbound',
    description: appDescription,
    url: 'https://dustbound.app/',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'iOS',
    installUrl: APP_STORE_URL,
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      priceCurrency: 'USD',
    },
    image: 'https://dustbound.app/og.jpg',
    author: { '@id': 'https://dustbound.app/#organization' },
  },
];
---
<Layout schema={appSchema}>
  <div class="relative isolate overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <Image
        src={gardenBg}
        alt=""
        class="h-full w-full object-cover object-top opacity-70"
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        quality={75}
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-panel/35 via-panel/65 to-panel"></div>
    </div>

    <div class="mx-auto max-w-5xl px-4 pb-16 pt-8 sm:px-6 sm:pt-10">
      <!-- Compact hero: brand icon is the signature visual -->
      <header class="relative pb-8" data-testid="hero">
        <div class="flex flex-col items-center gap-5 text-center sm:flex-row sm:items-center sm:gap-7 sm:text-left">
          <div class="brand-mark hero-brand-mark shrink-0" data-testid="brand-icon">
            <Image
              src={appIcon}
              alt="Dustbound app icon"
              width={160}
              height={160}
              widths={[120, 160, 240]}
              sizes="(max-width: 640px) 128px, 160px"
              quality={85}
              class="brand-mark__img h-32 w-32 sm:h-40 sm:w-40"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="max-w-xl space-y-3">
            <p class="inline-block rounded-full border border-accent px-3 py-1 text-xs font-bold uppercase tracking-widest text-accent" data-testid="available-now">
              Available now · iOS & Android
            </p>
            <h1 class="text-4xl font-black tracking-tight text-ink sm:text-5xl md:text-6xl">Dustbound</h1>
            <p class="text-lg font-semibold text-ink sm:text-xl" data-testid="thesis">
              Local checklist for Sprite collectibles — track Collected and Mastered, and Pair to trade or index.
            </p>
            <div id="get-the-app" class="pt-2 sm:pt-1">
              <StoreBadges />
            </div>
            <p class="text-sm text-muted" data-testid="soft-price">
              A one-time purchase on Google Play and the App Store — priced to stay low.
            </p>
          </div>
        </div>
      </header>

      <div class="mb-12">
        <SpriteConstellation />
      </div>

      <AppShowcase />

      <SeasonFour />

      <EventsSection />
    </div>
  </div>
</Layout>
