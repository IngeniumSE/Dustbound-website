---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Support" description="Contact support for Dustbound.">
  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6" data-testid="support-page">
    <h1 class="text-3xl font-black text-ink">Support</h1>
    <p class="mt-4 text-muted">
      For help with Dustbound, email
      <a href="mailto:support@ingeniumsoftware.dev" data-testid="support-email">support@ingeniumsoftware.dev</a>.
    </p>
    <p class="mt-3 text-sm text-muted">
      For privacy requests, use <a href="mailto:privacy@ingeniumsoftware.dev">privacy@ingeniumsoftware.dev</a>
      or see the <a href="/privacy/">Privacy policy</a>.
    </p>
  </article>
</Layout>
